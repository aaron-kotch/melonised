<% flash.each do |type, message| %>
  <div 
    data-controller="toast"
    class="fixed top-5 right-5 z-50 transition-transform duration-500 ease-in-out translate-x-[150%] p-4 rounded shadow-2xl text-white <%= type == 'notice' ? 'bg-green-600' : 'bg-red-600' %>"
  >
    <div class="flex items-center justify-between min-w-[200px]">
      <span class="font-medium"><%= message %></span>
      <button data-action="click->toast#dismiss" class="ml-4 text-xl leading-none">&times;</button>
    </div>
  </div>
<% end %>